{
  "name": "weifuwu",
  "type": "module",
  "version": "0.94.1",
  "description": "AI SaaS full-stack framework — backend HTTP + frontend VDOM + 129 components + CSS design system + SaaS foundation (auth/queue/AI). Zero-build, zero-dependency.",
  "files": [
    "dist/",
    "README.md",
    "docs/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build && tsc --emitDeclarationOnly --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:client && npm run test:scenario && npm run test:server",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "test:client": "node --env-file=.env --test --test-concurrency=4 'src/test/contract/**/*.test.ts'",
    "test:levels": "node --env-file=.env --test --test-concurrency=4 'src/test/contract/**/*.test.ts' 'src/level5/shared/**/*.test.ts' 'src/level5/server/core/**/*.test.ts' 'src/level5/server/db/*.test.ts'",
    "test:server": "node --env-file=.env --test --experimental-test-module-mocks --test-concurrency=8 'src/level5/server/**/*.test.ts' 'src/level6/server/**/*.test.ts'",
    "test:showcase": "node --env-file=.env --test --test-concurrency=6 --test-timeout=8000 src/level6/apps/showcase/test/comp-*.test.ts",
    "test:scenario": "node --env-file=.env --test --test-timeout=8000 --test-concurrency=14 'src/test/scenario/e2e*.test.ts'",
    "test:components": "node --env-file=.env --test --test-timeout=8000 --test-concurrency=2 src/test/scenario/e2e-6.test.ts",
    "audit:semantics": "node scripts/audit-level-semantics.mjs",
    "audit:showcase": "node scripts/audit-showcase-dev.mjs",
    "audit:all": "npm run audit:semantics && npm run audit:interactivity && npm run audit:vdom && npm run audit:theme && npm run audit:api && npm run audit:bundle && npm run audit:showcase && npm run audit:docs && npm run audit:health && npm run audit:levels",
    "test:contract-components": "node --env-file=.env --test 'src/level5/client/components/**/*.test.ts'",
    "audit:interactivity": "node scripts/audit-interactivity.mjs",
    "audit:theme": "node scripts/audit-theme.mjs",
    "audit:api": "node scripts/audit-api.mjs",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "audit:vdom": "node scripts/audit-vdom.mjs",
    "audit:docs": "node scripts/audit-docs-api.mjs",
    "audit:health": "node scripts/audit-component-health.mjs",
    "level:map": "node scripts/level-map.mjs",
    "level0:snapshot": "node scripts/level0-snapshot.mjs",
    "audit:levels": "node scripts/level-map.mjs --check && node scripts/level-graph.mjs --check && node scripts/level0-snapshot.mjs --check",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test:perf": "PERF_BASELINE=1 node --env-file=.env --test src/level5/server/core/router-contract.test.ts",
    "test:format": "node --test scripts/changelog-format.test.mjs",
    "platform:dev": "cd src/level6/apps/agent-platform && node --env-file=.env --watch server.ts",
    "platform:start": "cd src/level6/apps/agent-platform && node --env-file=.env server.ts",
    "platform:seed": "cd src/level6/apps/agent-platform && node --env-file=.env scripts/seed.mjs",
    "platform:build": "cd src/level6/apps/agent-platform && esbuild ui/v3-main.tsx --bundle --minify --format=esm --outfile=dist/app.js --jsx=automatic --jsx-import-source=weifuwu/client/vdom",
    "platform:build:sandbox": "mkdir -p src/level6/apps/agent-platform/dist/sandbox && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -C src/level5/sandbox -o \"$PWD/src/level6/apps/agent-platform/dist/sandbox/sandbox-agent\" .",
    "platform:pretest": "node -e \"try{const fs=require('fs');const p=fs.readFileSync('/tmp/ap-shared-server.pid','utf8').trim();process.kill(Number(p))}catch{}\"",
    "platform:posttest": "node -e \"const fs=require('fs');const p=fs.readFileSync('/tmp/ap-shared-server.pid','utf8').trim();try{process.kill(Number(p))}catch{}fs.rmSync('/tmp/ap-shared-server.pid',{force:true})\"",
    "platform:test": "npm run -s platform:pretest; cd src/level6/apps/agent-platform && node --env-file=.env --test --test-concurrency=1 'test/**/*.test.ts'; s=$?; npm run -s platform:posttest; exit $s",
    "platform:test:docker": "cd src/level6/apps/agent-platform && RUN_DOCKER_TESTS=1 node --env-file=.env --test --test-concurrency=1 test/sandbox.test.ts",
    "platform:test:ui": "cd src/level6/apps/agent-platform && node --env-file=.env --test --test-concurrency=1 'test/ui/**/*.test.ts'",
    "platform:typecheck": "cd src/level6/apps/agent-platform && npx tsc --noEmit",
    "platform:check:shapes": "cd src/level6/apps/agent-platform && node scripts/shape-check.mjs",
    "platform:audit:routes": "cd src/level6/apps/agent-platform && node scripts/audit-route-coverage.mjs",
    "platform:audit:pages": "cd src/level6/apps/agent-platform && node scripts/audit-page-generations.mjs",
    "platform:audit:any": "cd src/level6/apps/agent-platform && node scripts/audit-any.mjs"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "graphql": "^16"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "playwright": "^1.62.1"
  },
  "keywords": [
    "ai",
    "saas",
    "framework",
    "fullstack",
    "vdom",
    "components",
    "ui",
    "middleware",
    "websocket",
    "sse",
    "graphql",
    "postgres",
    "redis",
    "zero-build",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/weifuwu/weifuwu.git"
  },
  "homepage": "https://weifuwu.dev",
  "bin": {
    "weifuwu-showcase": "dist/level6/apps/showcase/cli.js",
    "weifuwu-platform": "dist/level6/apps/agent-platform/cli.js"
  }
}
