{
  "name": "weifuwu",
  "type": "module",
  "version": "0.63.1",
  "description": "AI SaaS framework — (req, ctx) => Response",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client/jsx-runtime": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./layout": "./dist/layout/weifuwu-layout.css",
    "./layout/style.css": "./dist/layout/weifuwu-layout.css",
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./components/style.css": "./dist/components/style.css",
    "./dev": "./dist/dev/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "docs/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build && tsc --emitDeclarationOnly --outdir dist",
    "typecheck": "tsc --noEmit",
    "pretest": "docker compose up -d --wait postgres redis 2>/dev/null; sleep 1",
    "test": "node --env-file=.env --test --test-concurrency=8 'src/test/**/*.test.ts' 'src/components/**/*.test.ts' 'src/db/**/*.test.ts'",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "graphql": "^16",
    "ws": "^8"
  },
  "peerDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/postcss": {
      "optional": true
    },
    "postcss": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@graphql-tools/schema": "^10.0.38",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25",
    "@types/ws": "^8",
    "ioredis": "^5.11.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.19",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3"
  },
  "sideEffects": false
}
