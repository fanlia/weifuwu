{
  "name": "weifuwu",
  "type": "module",
  "version": "0.87.0",
  "description": "AI SaaS full-stack framework — backend HTTP + frontend VDOM + 129 components + CSS design system + SaaS foundation (auth/queue/AI). Zero-build, zero-dependency.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./layout": "./dist/layout/weifuwu-layout.css",
    "./layout/style.css": "./dist/layout/weifuwu-layout.css",
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./components/style.css": "./dist/components/style.css",
    "./dev": "./dist/dev/index.js",
    "./vdom": {
      "types": "./dist/vdom/index.d.ts",
      "default": "./dist/vdom/index.js"
    },
    "./vdom/jsx-runtime": {
      "types": "./dist/vdom/index.d.ts",
      "default": "./dist/vdom/jsx-runtime.js"
    },
    "./vdom/testing": {
      "types": "./dist/vdom/testing.d.ts",
      "default": "./dist/vdom/testing.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "docs/",
    "content/",
    "examples/"
  ],
  "bin": {
    "weifuwu": "./dist/cli/docs.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build && tsc --emitDeclarationOnly --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:client && npm run test:server",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "test:client": "vitest run",
    "test:server": "node --env-file=.env --test --test-concurrency=8 'src/server/**/*.test.ts'",
    "test:cov:vdom": "vitest run --coverage.enabled --coverage.include='src/client/vdom/**' src/client/vdom/**/*.test.ts"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "graphql": "^16",
    "ws": "^8"
  },
  "peerDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/postcss": {
      "optional": true
    },
    "postcss": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@graphql-tools/schema": "^10.0.38",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25",
    "@types/ws": "^8",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "ioredis": "^5.11.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.19",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.11"
  },
  "sideEffects": false,
  "keywords": [
    "ai",
    "saas",
    "framework",
    "fullstack",
    "vdom",
    "components",
    "ui",
    "middleware",
    "websocket",
    "sse",
    "graphql",
    "postgres",
    "redis",
    "zero-build",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/weifuwu/weifuwu.git"
  },
  "homepage": "https://weifuwu.dev"
}
