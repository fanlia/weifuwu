{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "weifuwu/vdom",
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "weifuwu/vdom": ["./src/client/vdom/index.ts"],
      "weifuwu/vdom/jsx-runtime": ["./src/client/vdom/jsx-runtime.ts"],
      "weifuwu/vdom/testing": ["./src/client/vdom/testing.ts"],

    }
  },
  "include": [
    "src/server/*.ts",
    "src/server/**/*.ts",
    "src/client/*.ts",
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/cli/*.ts",
    "src/dev/*.ts"
  ],
  "exclude": [
    "src/client/components/**/*.test.ts",
    "src/server/**/*.test.ts",
    "src/client/**/*.test.ts",
    "src/server/db/postgres-server.ts",
    "src/server/db/redis/ast.ts"
  ]
}
