{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "weifuwu/ui-dom",
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "weifuwu/ui-dom": ["./src/ui-dom/index.ts"],
      "weifuwu/ui-dom/jsx-runtime": ["./src/ui-dom/jsx-runtime.ts"]
    }
  },
  "include": [
    "src/*.ts",
    "src/core/*.ts",
    "src/middleware/*.ts",
    "src/postgres/*.ts",
    "src/redis/*.ts",
    "src/graphql.ts",
    "src/types.ts",
    "src/ui-dom/*.ts",
    "src/ui-dom/**/*.ts",
    "src/client/*.ts",
    "src/client/**/*.ts",
    "src/ui/*.ts",
    "src/components/*.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx"
  ],
  "exclude": [
    "src/components/**/*.test.ts"
  ]
}
