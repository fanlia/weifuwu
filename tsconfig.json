{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "weifuwu/client/vdom",
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "weifuwu/client/vdom": ["./src/level6/client/vdom/index.ts"],
      "weifuwu/client/vdom/jsx-runtime": ["./src/level6/client/vdom/jsx-runtime.ts"],
      "weifuwu/client/vdom/testing": ["./src/level6/client/vdom/testing.ts"],
    }
  },
  "include": [
    "src/level0/**/*.ts",
    "src/level1/**/*.ts",
    "src/level2/**/*.ts",
    "src/level3/**/*.ts",
    "src/level3/**/*.tsx",
    "src/level4/**/*.ts",
    "src/level5/**/*.ts",
    "src/level5/**/*.tsx",
    "src/level6/**/*.ts",
    "src/level6/**/*.tsx"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/level5/server/db/redis/ast.ts",
    "src/level6/apps/**"
  ]
}
