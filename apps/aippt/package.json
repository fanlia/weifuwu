{
  "name": "aippt",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "AI PPT generation engine — deployable, programmable, batchable, provable",
  "scripts": {
    "dev": "node --env-file=../.env --watch server.ts",
