{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "weifuwu/vdom",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "weifuwu": [
        "../../src/server/index.ts"
      ],
      "weifuwu/vdom/jsx-runtime": [
        "../../src/client/vdom/jsx-runtime.ts"
      ],
      "weifuwu/vdom": [
        "../../src/client/vdom/index.ts"
      ],
      "weifuwu/components": [
        "../../src/client/components/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "server.ts",
    "ui/**/*.tsx"
  ]
}