{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "weifuwu/ui-dom": ["../../src/ui-dom/index.ts"],
      "weifuwu/components": ["../../src/components/index.ts"],
      "weifuwu/client": ["../../src/client/index.ts"]
    }
  },
  "include": ["src/**/*.tsx", "server.ts"]
}
