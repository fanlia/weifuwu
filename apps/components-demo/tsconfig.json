{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "weifuwu/ui-dom",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "weifuwu": ["../../src/index.ts"],
      "weifuwu/client": ["../../src/client/index.ts"],
      "weifuwu/client/jsx-runtime": ["../../src/client/index.ts"],
      "weifuwu/ui-dom/jsx-runtime": ["../../src/ui-dom/jsx-runtime.ts"],
      "weifuwu/ui-dom": ["../../src/ui-dom/index.ts"],
      "weifuwu/components": ["../../src/components/index.ts"]
    }
  },
  "include": ["src/**/*.tsx", "server.ts"]
}
